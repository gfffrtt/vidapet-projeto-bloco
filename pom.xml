<?xml version="1.0" encoding="UTF-8"?>
<!-- Gustavo Trapp - Projeto de Bloco (PB) - TP1 - Sistema VidaPet -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.vidapet</groupId>
    <artifactId>vidapet</artifactId>
    <version>0.1.0-TP1</version>
    <name>vidapet</name>
    <description>Sistema de Agendamento da Clínica Veterinária VidaPet - TP1 (programa standalone de console)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Apenas o núcleo do Spring Boot: no TP1 não há web, banco nem segurança -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
